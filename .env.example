# LakuFilm environment variables
# Copy file ini ke `.env.local` dan isi nilainya.

# Secret untuk menandatangani JWT (wajib diubah di produksi)
JWT_SECRET=ubah-ini-dengan-string-acak-yang-panjang

# API key Watchmode untuk rekomendasi film eksternal (opsional)
# Daftar gratis di https://api.watchmode.com/
# Jika kosong, bagian "rekomendasi eksternal" di beranda otomatis nonaktif.
WATCHMODE_API_KEY=
