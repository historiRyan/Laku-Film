# LakuFilm environment variables
# Copy file ini ke `.env.local` (lokal) dan set di Vercel Project Settings (production).

# Secret untuk menandatangani JWT (wajib diubah di produksi)
JWT_SECRET=ubah-ini-dengan-string-acak-yang-panjang

# API key Watchmode untuk rekomendasi film eksternal (opsional)
# Daftar gratis di https://api.watchmode.com/
WATCHMODE_API_KEY=

# --- Vercel / Upstash (wajib kalau deploy ke Vercel) ---
# Buat database Redis gratis di https://upstash.com -> REST API URL & token
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob (otomatis saat kamu "Add Store" -> Blob di dashboard Vercel)
BLOB_READ_WRITE_TOKEN=
# Opsional: domain publik blob (biasanya otomatis terisi)
BLOB_URL=
